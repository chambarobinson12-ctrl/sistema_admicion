# Copia este archivo como ".env" (en la misma carpeta que manage.py) y llena tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore) porque lleva contraseñas.

# --- Django ---
SECRET_KEY=pon-aqui-una-clave-larga-y-secreta
DEBUG=False
ALLOWED_HOSTS=midominio.com,www.midominio.com,127.0.0.1,localhost

# --- Base de datos MySQL ---
DB_NAME=admision_istam
DB_USER=usuario_mysql
DB_PASSWORD=contraseña_mysql
DB_HOST=localhost
DB_PORT=3306

# --- Correo (avisos a postulantes y recuperar contraseña) ---
# Con Gmail: EMAIL_HOST_PASSWORD es una "contraseña de aplicación" de 16 letras, sin espacios
# (se crea en myaccount.google.com/apppasswords con la verificación en 2 pasos activada).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=correo@gmail.com
EMAIL_HOST_PASSWORD=contraseñadeaplicacion
DEFAULT_FROM_EMAIL=Admisiones ISTAM <correo@gmail.com>
